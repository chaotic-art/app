    "baseline-browser-mapping": "^2.10.29",
    "eslint": "^10.3.0",
    "husky": "^9.1.7",
    "pino-pretty": "^13.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "vue-tsc": "^3.2.8"
