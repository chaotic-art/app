{
  "name": "chaotic-app",
  "type": "module",
  "version": "7.0.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": "^24.x"
  },
  "scripts": {
    "build": "papi --whitelist .papi/whitelist.ts && nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "generate:providers": "node scripts/generate-providers.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && npx gql-tada generate-output && papi",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "papi --whitelist .papi/whitelist.ts && nuxi typecheck"
  },
